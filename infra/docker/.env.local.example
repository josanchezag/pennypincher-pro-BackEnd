# Copy to .env.local (never committed) and adjust. Every value below is a local default.
# Usage: docker compose --env-file .env.local up -d --build

# --- PostgreSQL ---
POSTGRES_DB=pennypincher
POSTGRES_USER=pennypincher
POSTGRES_PASSWORD=pennypincher
POSTGRES_PORT=5432

# --- Backend ---
# `local` enables Swagger UI, POST /api/v1/auth/dev-login and generated RSA keys.
SPRING_PROFILES_ACTIVE=local
BACKEND_PORT=8080
# Comma-separated browser origins allowed by CORS (no "*": cookies are sent with credentials).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
# Google OAuth2 web client (also passed to the frontend build). Optional locally with dev-login.
# Leave empty until you have them; never commit real values.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact redirect URIs the frontend may use with Google (comma-separated). Must also be registered
# in the Google Cloud Console as "Authorized redirect URIs".
GOOGLE_ALLOWED_REDIRECT_URIS=http://localhost:3000/auth.html
# Refresh token cookie (ppp_refresh). Browsers accept Secure cookies on http://localhost.
# SameSite: Strict | Lax | None (None requires AUTH_COOKIE_SECURE=true).
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAME_SITE=Strict
# Base64-encoded PEM RSA key pair for RS256 access tokens. Leave empty locally to generate one
# at startup (kept in the `jwtkeys` volume, mounted at /app/keys); mandatory with the prod profile.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=

# --- Adminer (development only) ---
ADMINER_PORT=8090

# --- Frontend (only with --profile frontend) ---
FRONTEND_PORT=3000
# Browser-facing origin of the backend; the API base URL is <origin>/api/v1.
FRONTEND_API_ORIGIN=http://localhost:8080
FRONTEND_DEV_LOGIN=true
