# --- Secretos y configuración local ---
.env
.env.*
!.env.example
*.secrets
application-local.yml
application-local.yaml
application-local.properties
**/src/main/resources/*-secret*.yml
*.pem
*.key
*.p12
*.jks

# --- Gradle ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

# --- Kotlin ---
.kotlin/
*.class

# --- Empaquetados (el wrapper de Gradle se excluye arriba) ---
*.jar
!gradle/wrapper/gradle-wrapper.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# --- Logs / crash dumps ---
*.log
logs/
hs_err_pid*
replay_pid*

# --- IntelliJ IDEA ---
.idea/
*.iml
*.ipr
*.iws
out/
!**/src/main/**/out/
!**/src/test/**/out/

# --- VS Code ---
.vscode/*
!.vscode/launch.json
!.vscode/extensions.json

# --- Eclipse / STS / NetBeans ---
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
bin/
